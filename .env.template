# AI-Powered PDF Organizer Configuration
# Copy this file to .env and customize the values

# === EMBEDDING MODEL SETTINGS ===
# Default model (use: python main.py --list-models to see all options)
DEFAULT_MODEL=all-MiniLM-L6-v2

# Model type preference: local (recommended) or api (backup)
PREFER_LOCAL_MODELS=true

# === CLUSTERING SETTINGS ===
DEFAULT_CLUSTERS=auto
SIMILARITY_THRESHOLD=0.7

# === FILE PROCESSING ===
MAX_FILE_SIZE_MB=50
MIN_TEXT_LENGTH=100

# === OUTPUT SETTINGS ===
CREATE_TIMESTAMP_DIRS=true
COPY_FILES_DEFAULT=true

# === PERFORMANCE ===
DEFAULT_BATCH_SIZE=32
ENABLE_CACHING=true
CACHE_DIR=./cache

# === LOGGING ===
LOG_LEVEL=INFO
VERBOSE_OUTPUT=false